    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.30.5",
    "postcss": "^8.5.3",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.0.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.56.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
