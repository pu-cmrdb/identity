{
  "name": "identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "bunx auth generate --config src/server/auth/config.ts --output src/server/database/schema/auth.ts --yes",
    "start": "next start",
    "build": "next build",
    "check": "bun run lint && tsc --noEmit",
    "dev": "next dev --turbo --port 3000",
    "lint": "biome check --unsafe",
    "format": "biome check --unsafe --write",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "db:seed": "bun src/server/database/seed.ts",
    "db:generate": "bun run auth:generate && bun run drizzle:generate",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "@base-ui/react": "^1.2.0",
    "@better-auth/api-key": "^1.5.6",
    "@better-auth/oauth-provider": "^1.5.6",
    "@better-auth/passkey": "^1.5.6",
    "@hookform/resolvers": "^5.2.2",
    "@icons-pack/react-simple-icons": "^13.11.2",
    "@libsql/client": "^0.14.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "arktype": "^2.1.29",
    "better-auth": "^1.5.6",
    "better-auth-audit-logs": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.0",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
